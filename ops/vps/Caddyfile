# Proof or Bluff — Caddy reverse proxy
#
# Caddy gets Let's Encrypt certificates automatically for every hostname below
# (it needs ports 80 + 443 reachable and the DNS A record pointing here).
#
# Why Caddy sits in front of the proof server:
#   The proof server ships with Cors::permissive() — ANY website could use our
#   proving CPU. Caddy locks CORS to prooforbluff.app only, and answers
#   preflight (OPTIONS) requests itself so the proof server never sees them.

{
	email ops@prooforbluff.com
	# Uncomment while testing DNS to avoid burning Let's Encrypt rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Allowed browser origins. Production, plus OUR Vercel preview deployments
# (team-scoped suffix — never a bare *.vercel.app). The service re-checks the
# Origin itself (POB_ALLOWED_ORIGINS) so this is defence in depth, not the
# only gate. Preflights are answered here; the backends never see them.
(pob_cors) {
	@preflight method OPTIONS
	@origin_prod header Origin https://prooforbluff.app
	@origin_preview header Origin *-enterpisezk-labs-projects.vercel.app
	header @origin_prod Access-Control-Allow-Origin "https://prooforbluff.app"
	header @origin_preview Access-Control-Allow-Origin "{http.request.header.Origin}"
	header {
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type"
		Access-Control-Max-Age "86400"
		Vary "Origin"
		# Standard hardening
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	respond @preflight 204
}

# ── Hosted proof server ─────────────────────────────────────────────────────
# The browser posts proof preimages (private witnesses!) here. TLS is mandatory.
proof.prooforbluff.app {
	import pob_cors

	# Proofs can take minutes; don't let Caddy give up first.
	reverse_proxy proof-server:6300 {
		transport http {
			response_header_timeout 660s
			read_timeout 660s
		}
		# Proof payloads can be large (proving key material may be inlined).
	}
	# closeGame's proving key is ~340 MB and midnight-js inlines it in every
	# /prove payload — external operators/CLI runs need the headroom. The
	# browser never does this (hosted proving goes through our own backend).
	request_body {
		max_size 512MB
	}
}

# ── API: the wallet-free sponsored game service ─────────────────────────────
# Browser → here → pob-api (Node, docs/SPONSORED_GAME_API.md). Players send
# tiny JSON moves; the service plays the bot, holds the operator wallet and
# proves in the background. The Blockfrost token never leaves pob-api, so the
# browser never talks to Blockfrost at all — this hostname IS the "proxy".
api.prooforbluff.app {
	import pob_cors

	# Moves are a few hundred bytes. Anything bigger is not a legitimate client.
	request_body {
		max_size 64KB
	}

	reverse_proxy pob-api:3020 {
		transport http {
			# Game calls answer in milliseconds; proving is async, so no long
			# timeouts are needed here (unlike proof.).
			response_header_timeout 30s
			read_timeout 30s
		}
	}
}
