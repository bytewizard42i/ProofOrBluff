pragma language_version >= 0.22 && <= 0.23;

// signed-credential: in-circuit Schnorr signature verification over Jubjub,
// generic over the credential struct T.
//
// Lineage:
//   * Shape (generic SignedCredential<T>, sign/verify/challenge) ported from
//     Brick Towers `midnight-rwa` crypto.compact (Erick Romero, Copyright 2025
//     Brick Towers), modernised from language 0.18 (CurvePoint -> JubjubPoint).
//   * Challenge reduction taken from midnight-expert's `modules/crypto/schnorr.compact`
//     polyfill. Brick Towers reduced the challenge with an UNCHECKED witness
//     (`reduceChallenge`), which lets a malicious prover pick the challenge. Here the
//     witness supplies (quotient, remainder) and the circuit CHECKS the identity
//     hash == q * 2^248 + r with r : Uint<248>, so the reduction cannot be forged.
//   * Pinned >= 0.22 pending stdlib `jubjubSchnorrVerify`; when it lands, swap the
//     body of `verify` and drop the reduction witness.
//
// Why it matters for DIDzM: an OFF-chain issuer (KYCz IDP, DIDz issuer, oracle)
// signs a credential struct with its Jubjub secret key. The holder proves ON-chain,
// inside the ZK circuit, that the credential is validly signed by a trusted issuer,
// disclosing only the fields the consuming contract asserts on. This supersedes the
// "verify off-chain, pass a Boolean witness" pattern in `oracle-attestation`.

module SignedCredentials {
  import CompactStandardLibrary;

  // Fiat-Shamir challenge input: nonce point r, issuer pk, hash of the credential.
  export struct Challenge {
    r: JubjubPoint;
    pk: JubjubPoint;
    ch: Field;
  }

  // Deterministic nonce input (RFC-6979 style): k = H(sk, credential).
  export struct Nonce<T> {
    sk: Field;
    credential: T;
  }

  export struct Signature {
    r: JubjubPoint;
    s: Field;
  }

  // Transport shape: credential + signature + issuer public key.
  export struct SignedCredential<T> {
    credential: T;
    signature: Signature;
    pk: JubjubPoint;
  }

  // Prover-supplied (quotient, remainder) of the full challenge hash divided by
  // 2^248. Checked in-circuit; see `reduce_challenge`.
  witness get_challenge_reduction(challenge_hash: Field): [Field, Uint<248>];

  // pk = sk * G
  export pure circuit derive_pk(sk: Field): JubjubPoint {
    return ecMulGenerator(sk);
  }

  // Full (unreduced) challenge: c = H(r, pk, H(credential)). Exported so the
  // OFF-chain issuer service reuses the exact hash the circuit uses.
  export pure circuit compute_challenge<T>(r: JubjubPoint, pk: JubjubPoint, credential: T): Field {
    const credential_hash: Field = transientHash<T>(credential);
    return transientHash<Challenge>(Challenge { r: r, pk: pk, ch: credential_hash });
  }

  // k = H(sk, credential). Exported for the same signer/verifier hash-consistency reason.
  export pure circuit deterministic_k<T>(nonce: Nonce<T>): Field {
    return transientHash<Nonce<T>>(nonce);
  }

  // Truncate a ~255-bit BLS12-381 field hash to 248 bits so it is a valid Jubjub
  // scalar (subgroup order ~2^252.4). Soundness: the identity below is asserted,
  // and `r : Uint<248>` bounds the remainder, so the prover cannot choose c freely.
  export circuit reduce_challenge(full: Field): Field {
    const TWO_248: Field =
      452312848583266388373324160190187140051835877600158453279131187530910662656 as Field;
    const [q, r] = get_challenge_reduction(full);
    assert(disclose(q) * TWO_248 + (disclose(r) as Field) == full,
           "signed-credential: invalid challenge reduction");
    return disclose(r) as Field;
  }

  // Schnorr verify with an already-reduced challenge: s*G == r + c*pk
  export pure circuit verify<T>(signed: SignedCredential<T>, challenge: Field): Boolean {
    const lhs: JubjubPoint = ecMulGenerator(signed.signature.s);
    const rhs: JubjubPoint = ecAdd(signed.signature.r, ecMul(signed.pk, challenge));
    return jubjubPointX(lhs) == jubjubPointX(rhs) && jubjubPointY(lhs) == jubjubPointY(rhs);
  }

  // The guard consuming contracts call: recompute + reduce the challenge in-circuit,
  // check the signature, and check the signer is the expected trusted issuer.
  export circuit assert_signed_by<T>(signed: SignedCredential<T>, trusted_pk: JubjubPoint): [] {
    const full: Field = compute_challenge<T>(signed.signature.r, signed.pk, signed.credential);
    const c: Field = reduce_challenge(full);
    assert(verify<T>(signed, c), "signed-credential: signature invalid");
    assert(jubjubPointX(signed.pk) == jubjubPointX(trusted_pk) &&
           jubjubPointY(signed.pk) == jubjubPointY(trusted_pk),
           "signed-credential: not signed by trusted issuer");
  }
}
